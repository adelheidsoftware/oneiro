root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt,kts}]
indent_style = tab
max_line_length = 120

# Lua follows the RS3 plugin house style that stylua.toml checks: four-space indents and 120 columns
[*.lua]
indent_style = space
indent_size = 4
max_line_length = 120

[*.md]
max_line_length = 120
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
